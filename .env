# ============================================================
# AcciEye — Environment Variables
# ============================================================

# ── AI / LLM API Keys ─────────────────────────────────────
OPENROUTER_API_KEY_1=sk-or-v1
OPENROUTER_API_KEY_2=sk-or-v1
OPENROUTER_API_KEY_3=sk-or-v1
OPENROUTER_API_KEY_4=sk-or-v1
OPENROUTER_API_KEY_5=sk-or-v1
OPENROUTER_API_KEY_6=sk-or-v1

HF_TOKEN=hf_your-token-here

# ── Automation Webhook ────────────────────────────────────
# This is the internal Docker network URL (service-to-service)
INCIDENT_WEBHOOK_URL=https://ounawa.app.n8n.cloud/webhook/accident-alert
ENABLE_INCIDENT_WEBHOOK=true

# ── Timezone (for n8n logs and Telegram timestamps) ───────
TIMEZONE=Asia/Amman
